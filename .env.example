PORT=10000
NODE_ENV=development
DATA_DIR=./data
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PUBLIC_BASE_URL=http://localhost:10000
ROUTING_MODE=path
TRUST_PROXY=0
MAX_BODY_BYTES=16777216
STARTING_TOKENS=0
# Optional external services:
# PHOTON_REALTIME_APP_ID=
# PHOTON_VOICE_APP_ID=
# PHOTON_CHAT_APP_ID=
# PHOTON_REGION=us
# TACHYON_HOST_PORT=
# META_APP_SECRET=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_GUILD_ID=
# DISCORD_BENEFITS_ROLE_IDS=
# IMG_SIGNING_ENABLED=false
# IMG_SIGNING_KEY=
# Subdomain mode only: DOMAIN=example.com
# Never disable abuse controls for a public deployment.
# MAX_ACCOUNTS_PER_IP=3
# MAX_ACCOUNTS_PER_PLATFORM_ID=3

# Logging: debug | info | warn | error | off
# info  = [HTTP] por requisição, [HTTP_404], [PHOTON_AUTH]; debug = + corpo e headers (sempre mascarados)
LOG_LEVEL=info
# Photon (necessário para o cliente chegar ao serviço realtime):
# PHOTON_REALTIME_APP_ID=
# PHOTON_REGION=us
